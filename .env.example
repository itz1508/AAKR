# AAKR — Environment variable placeholders.
# Copy to .env and fill with real values. Never commit .env.

# ── Storage backend ────────────────────────────────────────────────────
# Provider: sqlite | databricks
AAKR_STORAGE_PROVIDER=sqlite

# SQLite path (when provider=sqlite)
AAKR_SQLITE_PATH=:memory:

# Databricks (when provider=databricks)
AAKR_DATABRICKS_CATALOG=oneshot_dev
AAKR_DATABRICKS_SCHEMA=knowledge
# AAKR_DATABRICKS_TOKEN=dapi...
# AAKR_DATABRICKS_HOST=https://...

# ── Lifecycle ─────────────────────────────────────────────────────────
AAKR_LIFECYCLE_DB_PATH=./aakr_lifecycle.db
AAKR_LIFECYCLE_MAX_ATTEMPTS=3
AAKR_LIFECYCLE_REVIEW_MODE=auto
AAKR_LIFECYCLE_EVIDENCE_KIND=test_assertion
AAKR_LIFECYCLE_RESEARCHER_IDENTITY=researcher

# ── Proposal gateway ─────────────────────────────────────────────────
AAKR_PROPOSAL_STORE_PATH=./aakr_proposals.db
AAKR_PROPOSAL_GATEWAY_TRUSTED=false

# ── Logging ───────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
AAKR_LOG_LEVEL=INFO
